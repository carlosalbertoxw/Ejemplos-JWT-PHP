RewriteEngine On

# Apache no pasa el encabezado Authorization a PHP por defecto;
# esta regla lo expone como variable de entorno.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Enviar toda petición que no sea un archivo o carpeta real al front
# controller (p. ej. /docs y openapi.json se sirven como estáticos).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
