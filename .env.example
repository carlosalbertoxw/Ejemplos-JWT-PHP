# Copia este archivo como .env (docker compose lo lee automáticamente).
# El .env real NUNCA se versiona.

# development (por defecto) o production.
# APP_ENV=development

# Clave para firmar los JWT: larga y aleatoria (>= 32 bytes). Generar una, p. ej.:
#   openssl rand -hex 32
# Si se deja vacía en desarrollo, la API genera una y la guarda en api/data/.
# Con APP_ENV=production es obligatoria.
JWT_SECRET=

# Opcionales (tienen valores por defecto razonables):
# JWT_ISSUER=jwt-api-php
# JWT_AUDIENCE=jwt-webapp-php
# ACCESS_TOKEN_TTL=900
# REFRESH_TOKEN_TTL=604800
# RATE_LIMIT_MAX_ATTEMPTS=5        # fallos permitidos por cuenta
# RATE_LIMIT_IP_MAX_ATTEMPTS=20    # fallos permitidos por IP (todas las cuentas)
# RATE_LIMIT_WINDOW_SECONDS=900
